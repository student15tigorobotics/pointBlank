; Engine configuration file.
; Godot 4.7 (GDScript). Target: Android standalone XR (VIVE XR Elite), OpenXR.
; Desktop preview runs from the same project: godot --path godot -- --desktop

config_version=5

[application]

config/name="PointBlank Swarm"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

general/text_to_speech=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/environment_blend_mode=0
openxr/reference_space=1
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
