; Engine configuration file.
; Godot 4.7 (GDScript). One project, several games. The launcher (launcher/) is the entry scene.
; Games: PointBlank Swarm (Android standalone XR, OpenXR; desktop preview with --desktop) and
; Picket Line (desktop, games/picket_line/). Desktop uses Forward+; the Android export uses the mobile renderer.
; Run: godot --path godot          (menu)
;      godot --path godot -- --game=picket_line

config_version=5

[application]

config/name="PointBlank Arcade"
config/icon="res://icon.png"
config/version="0.1.0"
run/main_scene="res://launcher/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

general/text_to_speech=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/environment_blend_mode=0
openxr/reference_space=1
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
